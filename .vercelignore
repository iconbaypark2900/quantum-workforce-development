# API deploy size: exclude heavy UI build artifacts and the CRA app.
# Do NOT ignore the whole `web/` tree — that breaks the Learn/Next Vercel
# project (Root Directory = web) by stripping package-lock.json / source.
legacy

web/node_modules
web/.next
web/out
frontend

notebooks
examples
tests
huggingface

.github
.cursor
.vscode
.claude
.qwen

.venv
venv
.pytest_cache

# OpenAPI for /api/docs/openapi — keep only this under docs/
docs/**
!docs/openapi.yaml

# Root markdown (not runtime); README kept for pyproject / metadata
*.md
!README.md

# Large / non-runtime assets — do NOT use blanket *.pdf / *.png.
# Those patterns also match web/public/learn/** and break Classroom PDFs
# + Navigator images on the Learn Vercel deploy.
/*.png
/*.pdf
/*.docx
docs/**/*.png
docs/**/*.pdf
docs/**/*.docx
*.log
api_output.log
api_config_patch.py
chang_validation_report.png
docs/specs/core_features_spec.pdf
docs/specs/core_features_spec.docx

deploy/docker/Dockerfile
deploy/docker/Dockerfile.*
deploy/docker/docker-compose.yml
deploy/docker/docker-compose*.yml

scripts/deploy_hf_spaces.sh
scripts/demo_dashboard_features.sh
scripts
